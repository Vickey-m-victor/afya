import { defineStore } from "pinia";
import {{camelCase entityName}}Service from "~/{{camelCase moduleName}}/services/{{camelCase entityName}}Service";

export const use{{pascalCase entityName}}Store = defineStore("{{camelCase entityName}}", {
  state: () => ({
    items: [],
    loading: false,
  }),
  actions: {
    async fetchAll(searchQuery = "") {
      this.loading = true;
      try {
        const response = await {{camelCase entityName}}Service.getAll(searchQuery);
        this.items = response.data?.dataPayload?.data || response.data;
      } catch (error) {
        throw error;
      } finally {
        this.loading = false;
      }
    },
    async create(payload) {
      const response = await {{camelCase entityName}}Service.create(payload);
      await this.fetchAll(); 
      return response;
    },
    async update(id, payload) {
      const response = await {{camelCase entityName}}Service.update(id, payload);
      await this.fetchAll(); 
      return response;
    },
    async delete(id) {
      const response = await {{camelCase entityName}}Service.delete(id);
      await this.fetchAll(); 
      return response;
    }
  }
});